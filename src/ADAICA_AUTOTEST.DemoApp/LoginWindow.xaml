<Window x:Class="ADAICA_AUTOTEST.DemoApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADAICA — Вхід"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UserNameTextBox}"
        AutomationProperties.AutomationId="LoginWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Логін" />
        <TextBox x:Name="UserNameTextBox"
                 AutomationProperties.AutomationId="UserNameTextBox"
                 Margin="0,4,0,12"
                 TextChanged="OnCredentialsChanged" />

        <TextBlock Text="Пароль" />
        <PasswordBox x:Name="PasswordBox"
                     AutomationProperties.AutomationId="PasswordBox"
                     Margin="0,4,0,12"
                     PasswordChanged="OnCredentialsChanged" />

        <TextBlock x:Name="ErrorText"
                   AutomationProperties.AutomationId="ErrorText"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Button x:Name="LoginButton"
                AutomationProperties.AutomationId="LoginButton"
                Content="Увійти"
                IsDefault="True"
                IsEnabled="False"
                Padding="12,4"
                HorizontalAlignment="Right"
                Click="OnLoginClick" />
    </StackPanel>
</Window>
