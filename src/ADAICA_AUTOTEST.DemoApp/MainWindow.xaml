<Window x:Class="ADAICA_AUTOTEST.DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADAICA — Головне вікно"
        Width="480"
        Height="400"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=NewItemTextBox}"
        AutomationProperties.AutomationId="MainWindow">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="LogoutButton"
                    AutomationProperties.AutomationId="LogoutButton"
                    DockPanel.Dock="Right"
                    Content="Вийти"
                    Padding="12,4"
                    Click="OnLogoutClick" />
            <TextBlock x:Name="WelcomeText"
                       AutomationProperties.AutomationId="WelcomeText"
                       FontSize="16"
                       VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="AddItemButton"
                    AutomationProperties.AutomationId="AddItemButton"
                    DockPanel.Dock="Right"
                    Content="Додати"
                    IsDefault="True"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Click="OnAddItemClick" />
            <TextBox x:Name="NewItemTextBox"
                     AutomationProperties.AutomationId="NewItemTextBox"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="ItemsCountText"
                   AutomationProperties.AutomationId="ItemsCountText"
                   DockPanel.Dock="Bottom"
                   Margin="0,8,0,0" />

        <ListBox x:Name="ItemsListBox"
                 AutomationProperties.AutomationId="ItemsListBox" />
    </DockPanel>
</Window>
