<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ADAICA_AUTOTEST</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\ADAICA_AUTOTEST.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Allure.NUnit" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="JunitXml.TestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!--
    Демо-застосунок збирається разом із тестами, а шлях до його exe вшивається в збірку
    як значення за замовчуванням для TestSettings.AppPath.
    Коли тести переключаться на реальний застосунок, цей блок можна видалити.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ADAICA_AUTOTEST.DemoApp\ADAICA_AUTOTEST.DemoApp.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="DemoAppPath" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\src\ADAICA_AUTOTEST.DemoApp\bin\$(Configuration)\$(TargetFramework)\ADAICA_AUTOTEST.DemoApp.exe'))" />
  </ItemGroup>

  <ItemGroup>
    <None Update="allureConfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
