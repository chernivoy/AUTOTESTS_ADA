<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Максимальна тривалість усього прогону, мс. -->
    <TestSessionTimeout>10800000</TestSessionTimeout>
  </RunConfiguration>

  <!--
    Параметри доступні в тестах через TestSettings.
    Змінні середовища (ADAICA_APP_PATH, ADAICA_USER, ...) мають вищий пріоритет.
    Пароль тут не зберігайте: передавайте його змінною ADAICA_PASSWORD.
  -->
  <TestRunParameters>
    <!-- Повний шлях до exe ADAICA; на Jenkins задається параметром APP_PATH. -->
    <Parameter name="AppPath" value="C:\adaica\feature_documents-in-postgre\ADAICA.exe" />
    <Parameter name="AppStartTimeoutSeconds" value="60" />
    <Parameter name="DefaultTimeoutSeconds" value="10" />
    <Parameter name="LoginTimeoutSeconds" value="60" />
    <Parameter name="UserName" value="cher" />
    <!-- Другий користувач (чат), пароль той самий (ADAICA_PASSWORD); контакт — як він підписаний у списку учасників. -->
    <Parameter name="SecondUserName" value="anna" />
    <Parameter name="SecondUserContact" value="van de Goldun, Anna Dr." />
    <Parameter name="Database" value="BLANK_IGOR" />
    <Parameter name="Schema" value="BLANK_IGOR" />
    <!--
      Монітор для вікна ADAICA: secondary (перший неосновний), primary або ім'я пристрою (\\.\DISPLAY2).
      Якщо такого монітора немає (наприклад, на Jenkins), вікно лишається, де його відкрила ADAICA.
    -->
    <Parameter name="Monitor" value="secondary" />
    <!--
      Як тести клікають там, де не допомагає UI Automation:
      Background — повідомленнями вікну, а не подіяло — мишею й клавіатурою;
      BackgroundOnly — лише повідомленнями (миша й клавіатура користувача не потрібні ніколи);
      Mouse — лише мишею й клавіатурою.
    -->
    <Parameter name="InputMode" value="Background" />
  </TestRunParameters>
</RunSettings>
